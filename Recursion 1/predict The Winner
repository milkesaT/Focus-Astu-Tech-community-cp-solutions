class Solution:
    def predictTheWinner(self, nums: list[int]) -> bool:
        def solve(left, right):
            if left == right:
                return nums[left]
            takeLeft = nums[left] - solve(left + 1, right)
            takeRight = nums[right] - solve(left, right - 1)
            return max(takeLeft, takeRight)
        result = solve(0, len(nums) - 1)
        return result>=0
